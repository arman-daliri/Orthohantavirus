__pycache__/
*.py[cod]
.venv/

# The pipeline log is written fresh on every run and records absolute paths for the
# machine it ran on. output/ortho_pipeline.log is already tracked; untrack it with
# `git rm --cached output/ortho_pipeline.log` if you would rather it not be committed.
output/*.log

# External tool binaries: 38 MB of downloadable archives plus their extracted trees.
# The pin is recorded by tools/CHECKSUMS.sha256 and tools/VERSIONS.txt, which ARE
# tracked -- committing the artifacts themselves would bloat the repo to no purpose.
tools/dist/
tools/mafft-win/
tools/iqtree-3.1.3-Windows/
tools/_download_meta.json

# Stage 1's reference snapshot -- derived from all_hanta/ (also gitignored, see Step 1 in
# the README), so committing it without its source would be misleading provenance. It
# regenerates deterministically in ~16 seconds; run prepare_dataset.py before Stages 2/3.
output/phylo_rpi_ga_isolates.json
output/phylo_rpi_ga_genomic.json
output/phylo_rpi_ga_cds.json
output/phylo_rpi_ga_snapshot_manifest.json

# Step 1 pool files and Step 3 GA-search outputs -- all regenerable by running the
# pipeline; large (pool CSVs ~3 MB; ga_search/ tree artifacts can exceed 1 GB).
output/ga_pool_*.csv
output/ga_pools_manifest.json
output/ga_search/

# Step 3 validation gate4 tree artifacts -- MAFFT alignments and IQ-TREE outputs
# per candidate, regenerable with `rpi_core.py validate --with-phylogeny`. Each
# alignment file runs ~76,000 lines; the full panel produces >1,400 files. The
# summary validation_report.json IS tracked (it's the scored result, not raw
# alignment bytes).
output/validation/candidate_phylogenetics/

# Captured stdout/stderr from pipeline runs -- record absolute paths and machine-
# specific timing; not a research artifact.
output/*_stdout.txt
output/*_stderr.txt
