#nexus

BEGIN Taxa;
DIMENSIONS ntax=4;
TAXLABELS
[1] 'I0000'
[2] 'I0001'
[3] 'I0002'
[4] 'I0003'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=4 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 1 4,
	100	 4,
	100	 1,
	0	 1 3,
	0	 1 2,
;
END; [Splits]

