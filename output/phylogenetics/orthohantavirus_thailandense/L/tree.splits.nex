#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'I0000'
[2] 'I0001'
[3] 'I0002'
[4] 'I0003'
[5] 'I0004'
[6] 'I0005'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=16;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	93	 3 4,
	88	 1 5 6,
	100	 5,
	80	 1 6,
	100	 6,
	100	 1,
	4	 3 6,
	9	 1 2 5,
	18	 1 5,
	0	 2 5,
	2	 2 6,
	2	 5 6,
	4	 4 6,
;
END; [Splits]

