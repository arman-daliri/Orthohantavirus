	91	 2 4,
	100	 5,
	91	 1 3 6,
	100	 3,
	95	 1 6,
	100	 6,
	100	 1,
	9	 2 5,
	0	 3 4,
	5	 1 3,
	4	 3 5,
	1	 5 6,
	1	 1 3 5,
	0	 3 6,
	2	 1 5 6,
	0	 4 5,
	0	 1 4 6,
	0	 1 2 4,
	0	 1 2 6,
;
