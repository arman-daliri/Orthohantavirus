#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'I0000'
[2] 'I0001'
[3] 'I0002'
[4] 'I0003'
[5] 'I0004'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=7;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	100	 4,
	100	 3 4,
	100	 1 5,
	100	 5,
	100	 1,
;
END; [Splits]

